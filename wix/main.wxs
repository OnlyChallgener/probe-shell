<?xml version="1.0" encoding="windows-1252"?>
<!--
  WiX v3 installer definition for Probe Shell.

  Release passes these preprocessor variables to candle.exe:
    $(var.Version)            package version from Cargo.toml
    $(var.CargoTargetBinDir)  compiled target release directory

  IMPORTANT: UpgradeCode is the identity already shipped by Probe Shell
  v0.7.0-v0.7.3. Do not change it.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Product
        Id="*"
        Name="Probe Shell"
        UpgradeCode="BDBCF0D4-8911-49BD-8C74-B1130B7B10A7"
        Manufacturer="OnlyChallgener"
        Language="1033"
        Codepage="1252"
        Version="$(var.Version)">

        <Package Id="*"
            Keywords="Installer"
            Description="Probe Shell - lightweight SSH/SFTP terminal client"
            Manufacturer="OnlyChallgener"
            InstallerVersion="500"
            Languages="1033"
            Compressed="yes"
            InstallScope="perMachine"
            Platform="x64"
            SummaryCodepage="1252"/>

        <MajorUpgrade
            Schedule="afterInstallInitialize"
            DowngradeErrorMessage="A newer version of Probe Shell is already installed. Setup will now exit."/>

        <MediaTemplate EmbedCab="yes"/>

        <Icon Id="ProductICO" SourceFile="assets\probe-shell.ico"/>
        <Property Id="ARPPRODUCTICON" Value="ProductICO"/>

        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="ProgramFiles64Folder">
                <Directory Id="APPLICATIONFOLDER" Name="Probe Shell">
                    <Component Id="MainExecutable" Guid="*" Win64="yes">
                        <File Id="ProbeShellEXE"
                              Name="probe-shell.exe"
                              Source="$(var.CargoTargetBinDir)\probe-shell.exe"
                              KeyPath="yes"/>
                    </Component>
                </Directory>
            </Directory>
        </Directory>

        <Feature Id="MainProgram" Title="Probe Shell" Level="1">
            <ComponentRef Id="MainExecutable"/>
        </Feature>

        <Property Id="WIXUI_INSTALLDIR" Value="APPLICATIONFOLDER"/>
        <UIRef Id="WixUI_InstallDir"/>
        <UIRef Id="WixUI_ErrorProgressText"/>
    </Product>
</Wix>
