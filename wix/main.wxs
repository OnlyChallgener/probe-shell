<?xml version="1.0" encoding="windows-1252"?>
<!--
  WiX v3 installer definition for Probe Shell.

  Release passes these preprocessor variables to candle.exe:
    $(var.Version)            package version from Cargo.toml
    $(var.CargoTargetBinDir)  compiled target release directory

  IMPORTANT: UpgradeCode is the identity already shipped by the real Probe Shell
  MSI releases starting with v0.7.0. Do not change it.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Product
        Id="*"
        Name="Probe Shell"
        UpgradeCode="BDBCF0D4-8911-49BD-8C74-B1130B7B10A7"
        Manufacturer="OnlyChallgener"
        Language="1033"
        Codepage="1252"
        Version="$(var.Version)">

        <Package
            Id="*"
            Keywords="Installer"
            Description="Probe Shell - lightweight SSH/SFTP terminal client"
            Manufacturer="OnlyChallgener"
            InstallerVersion="500"
            Languages="1033"
            Compressed="yes"
            InstallScope="perMachine"
            Platform="x64"
            SummaryCodepage="1252"/>

        <MajorUpgrade
            Schedule="afterInstallInitialize"
            DowngradeErrorMessage="A newer version of Probe Shell is already installed. Setup will now exit."/>

        <MediaTemplate EmbedCab="yes"/>

        <Icon Id="ProductICO" SourceFile="assets\probe-shell.ico"/>
        <Property Id="ARPPRODUCTICON" Value="ProductICO"/>
        <Property Id="ARPURLINFOABOUT" Value="https://github.com/OnlyChallgener/probe-shell"/>
        <Property Id="ARPHELPLINK" Value="https://github.com/OnlyChallgener/probe-shell/issues"/>
        <Property Id="ARPCONTACT" Value="OnlyChallgener"/>
        <Property Id="ARPCOMMENTS" Value="Probe Shell SSH/SFTP terminal client"/>

        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="ProgramFiles64Folder">
                <Directory Id="APPLICATIONFOLDER" Name="Probe Shell"/>
            </Directory>
            <Directory Id="ProgramMenuFolder">
                <Directory Id="ProgramMenuDir" Name="Probe Shell"/>
            </Directory>
        </Directory>

        <DirectoryRef Id="APPLICATIONFOLDER">
            <Component Id="MainExecutable" Guid="*" Win64="yes">
                <File
                    Id="ProbeShellEXE"
                    Name="probe-shell.exe"
                    Source="$(var.CargoTargetBinDir)\probe-shell.exe"
                    KeyPath="yes">
                    <Shortcut
                        Id="StartMenuShortcut"
                        Directory="ProgramMenuDir"
                        Name="Probe Shell"
                        Description="Probe Shell SSH/SFTP terminal client"
                        WorkingDirectory="APPLICATIONFOLDER"
                        Advertise="yes"/>
                </File>
                <RemoveFolder
                    Id="RemoveProgramMenuDir"
                    Directory="ProgramMenuDir"
                    On="uninstall"/>
            </Component>
        </DirectoryRef>

        <Feature Id="MainProgram" Title="Probe Shell" Level="1">
            <ComponentRef Id="MainExecutable"/>
        </Feature>

        <CustomAction
            Id="SetARPInstallLocation"
            Property="ARPINSTALLLOCATION"
            Value="[APPLICATIONFOLDER]"/>
        <InstallExecuteSequence>
            <Custom Action="SetARPInstallLocation" After="CostFinalize">NOT REMOVE</Custom>
        </InstallExecuteSequence>

        <Property Id="WIXUI_INSTALLDIR" Value="APPLICATIONFOLDER"/>
        <UIRef Id="WixUI_InstallDir"/>
        <UIRef Id="WixUI_ErrorProgressText"/>
    </Product>
</Wix>
